# Copy to .env (next to compose.yaml) or paste into the openmediavault compose
# "Environment" field. Never commit the filled-in file.

# Incoming media to rename, mounted at /media in the container.
# On openmediavault this is a shared folder path such as:
#   /srv/dev-disk-by-uuid-1234abcd/Downloads
MEDIA_PATH=/srv/dev-disk-by-uuid-CHANGE-ME/Downloads

# Library that renamed files can be moved into, mounted at /library.
# May be on another disk; cross-disk moves copy, verify, then delete the original.
# Leave unset to use MEDIA_PATH.
LIBRARY_PATH=/srv/dev-disk-by-uuid-CHANGE-ME/Media

# Default destinations inside the container, one for TV shows and one for movies
# (subfolders of /library here). Empty = rename that kind in place. The web UI's
# "Save as default" overrides these and keeps its choice in ./config.
MEDIA_RENAMER_TV_TARGET=/library/TV
MEDIA_RENAMER_MOVIE_TARGET=/library/Movies

# Only process video files (skip subtitles), and whether to keep release samples.
MEDIA_RENAMER_VIDEO_ONLY=true
MEDIA_RENAMER_INCLUDE_SAMPLES=false

# Metadata language and movie release region. Localised TV titles need TMDB_API_KEY.
# Examples: de-DE / DE, fr-FR / FR. Leave the region empty to match movies globally.
MEDIA_RENAMER_LANGUAGE=en-US
MEDIA_RENAMER_REGION=

# Run as the owner of the media files so renames keep the right ownership.
# Find the values on the NAS with:  id <your-user>
PUID=1000
PGID=100
# Folders created by renames: 002 = group-writable, 022 = owner-only writable.
UMASK=002

# Port on the NAS for the web UI: http://<nas>:4173/
MEDIA_RENAMER_PORT=4173

# Hostnames/IPs you use to open the UI (comma-separated). Blocks DNS rebinding.
MEDIA_RENAMER_ALLOWED_HOSTS=openmediavault.local,192.168.1.10

# Password for the web UI (HTTP Basic auth; any user name). Strongly recommended.
MEDIA_RENAMER_PASSWORD=

# TMDB API key or v4 read access token for movie lookups (optional).
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Time zone for log timestamps, e.g. Europe/Berlin or America/New_York.
TZ=Etc/UTC
